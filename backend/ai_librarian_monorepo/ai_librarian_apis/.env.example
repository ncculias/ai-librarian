# API settings.
DEBUG="false" # Uvicorn auto-reload(hot-reload).
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=[] # CORS allowed origins.

# LLM API keys(at least one is required).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY= # Must enable Generative Language API in GCP.
GROQ_API_KEY=

# Emotion detection (v2 stream). Uses an OpenAI model by default, so OPENAI_API_KEY is required for it;
# without the key every turn falls back to "neutral". Optional model override:
# EMOTION_MODEL=openai:gpt-5.4-mini

# Langsmith for tracing LLM calls(Optional).
LANGSMITH_TRACING="false" # Set this to "true" if you want to use it.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_PROJECT="ai-librarian"

# Tools credentials.
# To use Google Books and Google Search, you need Custom Search API and Books API in GCP in addition to Generative Language API.
GOOGLE_CSE_ID=
OPENWEATHERMAP_API_KEY=